<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
        x:Class="OmegaLauncher.Avalonia.Views.UpdatesWindow"
        Title="Client Updates"
        Width="900" Height="640" CanMinimize="False" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Grid RowDefinitions="Auto Auto * Auto Auto" Margin="32 24 32 28" RowSpacing="18">

        <TextBlock Grid.Row="0" Classes="heading" FontSize="44" Text="Client updates" />

        <!-- Game folder -->
        <Border Grid.Row="1" Classes="card" Padding="22">
            <Grid ColumnDefinitions="* 16 Auto">
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="caption" Text="GAME FOLDER" />
                    <TextBlock x:Name="FolderTextBlock" FontSize="18" TextWrapping="Wrap" Text="C:\Marvel Heroes" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="ChangeFolderButton" Click="ChangeFolderButton_Click" VerticalAlignment="Center">Change...</Button>
            </Grid>
        </Border>

        <!-- Status -->
        <Border Grid.Row="2" Classes="card" Padding="22">
            <Grid RowDefinitions="Auto Auto *" RowSpacing="12">
                <TextBlock Grid.Row="0" Classes="caption" Text="STATUS" />
                <ProgressBar Grid.Row="1" x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="10" IsVisible="False" />
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="StatusTextBlock" FontSize="20" TextWrapping="Wrap" Text="Not checked yet." />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" ColumnDefinitions="* 14 *" RowDefinitions="Auto Auto" RowSpacing="14">
            <Button Grid.Column="0" Grid.Row="0" x:Name="CheckButton" Click="CheckButton_Click" HorizontalAlignment="Stretch">Check for updates</Button>
            <Button Grid.Column="2" Grid.Row="0" x:Name="UpdateButton" Classes="primary" Click="UpdateButton_Click" HorizontalAlignment="Stretch" IsEnabled="False">Update now</Button>
            <Button Grid.Column="0" Grid.Row="1" x:Name="VerifyButton" Click="VerifyButton_Click" HorizontalAlignment="Stretch">Verify all files (slow)</Button>
            <Button Grid.Column="2" Grid.Row="1" x:Name="RevertButton" Click="RevertButton_Click" HorizontalAlignment="Stretch">Restore original files</Button>
        </Grid>

        <!-- Close -->
        <Button Grid.Row="4" x:Name="CloseButton" Click="CloseButton_Click" IsDefault="True" HorizontalAlignment="Stretch">Close</Button>
    </Grid>

</Window>
