<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Bifrost.Avalonia.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://Bifrost/Styles/LauncherStyles.axaml" />

        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="auto *" Margin="4 4 4 14" RowSpacing="6">
                        <TextBlock Grid.Row="0" Classes="caption" Margin="4 0 0 0" Text="{TemplateBinding Header}" />
                        <Border Grid.Row="1" Background="{DynamicResource LauncherPanelBrush}" BorderBrush="{DynamicResource LauncherLineBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="HeaderedContentControl > Grid">
            <Setter Property="ColumnSpacing" Value="8" />
            <Setter Property="RowSpacing" Value="10" />
        </Style>

        <Style Selector="HeaderedContentControl > StackPanel">
            <Setter Property="Spacing" Value="8" />
        </Style>

    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="BebasNeue">/Assets/Fonts/BebasNeue-Regular.ttf#Bebas Neue</FontFamily>
    </Application.Resources>

</Application>