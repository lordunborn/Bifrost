<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Bifrost.Avalonia.Views.MainWindow"
        Title="Marvel Heroes Omega"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Opened="Window_Opened"
        Closed="Window_Closed">

    <!-- The whole launcher is drawn on a fixed 1280x800 canvas (the Steam Deck screen) and scaled to the window, so it looks the same everywhere. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="800" RowDefinitions="96 * 72" x:Name="MainGrid" KeyboardNavigation.TabNavigation="Cycle">

            <Grid.Background>
                <ImageBrush Source="/Assets/Images/background.png" Stretch="UniformToFill" />
            </Grid.Background>

            <Grid.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="#E8EEF5" />
                </Style>

                <Style Selector="Border.ready-icon">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="CornerRadius" Value="16" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                </Style>

                <Style Selector="Border.ready-icon > TextBlock">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Foreground" Value="#06140B" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>

                <Style Selector="HyperlinkButton.news-item">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="MinHeight" Value="84" />
                    <Setter Property="Background" Value="#99000000" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="4 0 0 0" />

                    <Style Selector="^ TextBlock">
                        <Setter Property="Margin" Value="14 12" />
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                        <Setter Property="TextWrapping" Value="Wrap" />
                        <Setter Property="FontFamily" Value="{DynamicResource ResourceKey=BebasNeue}" />
                        <Setter Property="FontSize" Value="22" />
                        <Setter Property="Foreground" Value="#35B6FF" />
                        <Setter Property="TextDecorations" Value="{x:Null}" />
                    </Style>
                </Style>

                <Style Selector="HyperlinkButton.news-item:pointerover">
                    <Style Selector="^ TextBlock">
                        <Setter Property="Foreground" Value="#FFFFFF" />
                    </Style>
                </Style>

                <Style Selector="ScrollBar:vertical">
                    <Style Selector="^ /template/ RepeatButton">
                        <Setter Property="Background" Value="{x:Null}" />
                    </Style>
                    <Style Selector="^ /template/ Border">
                        <Setter Property="Background" Value="{x:Null}" />
                    </Style>
                </Style>

                <Style Selector="Button.play-button">
                    <Setter Property="Background" Value="#18A62E" />
                    <Setter Property="BorderBrush" Value="#5CE27A" />
                    <Setter Property="CornerRadius" Value="14" />
                    <Setter Property="FontFamily" Value="{DynamicResource ResourceKey=BebasNeue}" />
                    <Setter Property="FontSize" Value="64" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Height" Value="128" />
                </Style>

                <Style Selector="Button.play-button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#1FD13C" />
                </Style>

                <Style Selector="Button.play-button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Background" Value="#1FD13C" />
                </Style>

            </Grid.Styles>

            <!-- Header -->
            <Grid Grid.Row="0" Background="#B3060A10" ColumnDefinitions="* Auto Auto" Margin="0">
                <StackPanel Grid.Column="0" Margin="40 0 0 0" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Classes="heading" FontSize="52" Text="Marvel Heroes Omega" />
                    <TextBlock Classes="caption" Text="PRIVATE SERVER LAUNCHER" />
                </StackPanel>

                <ComboBox Grid.Column="1" Width="300" Margin="0 0 12 0" VerticalAlignment="Center" SelectedIndex="0" x:Name="ServerComboBox" SelectionChanged="ServerComboBox_SelectionChanged">
                    <ComboBoxItem Content="Local Server" />
                </ComboBox>

                <Button Grid.Column="2" Margin="0 0 40 0" VerticalAlignment="Center" x:Name="ManageServersButton" Click="ManageServersButton_Click">Manage servers</Button>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" ColumnDefinitions="* 24 400" Margin="40 28 40 24">

                <!-- Play and status -->
                <Grid Grid.Column="0" RowDefinitions="Auto * " RowSpacing="20">
                    <Border Grid.Row="0" Classes="card">
                        <Grid ColumnDefinitions="* 24 320">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="10">
                                <TextBlock Classes="caption" Text="STATUS" />
                                <TextBlock FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" MinHeight="70" x:Name="UpdateStatusTextBlock" Text="Starting..." />
                                <ProgressBar Minimum="0" Maximum="100" Height="10" IsVisible="False" x:Name="UpdateProgressBar" />
                            </StackPanel>

                            <Button Grid.Column="2" Classes="play-button" x:Name="PlayButton" Click="PlayButton_Click">Play</Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Classes="card">
                        <StackPanel Spacing="20">
                            <TextBlock Classes="caption" Text="READY CHECK" />

                            <Grid ColumnDefinitions="32 14 *">
                                <Border Grid.Column="0" Classes="ready-icon" Background="#6B7C8F" x:Name="ClientIcon"><TextBlock x:Name="ClientIconText" Text="?" /></Border>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Game client" />
                                    <TextBlock FontSize="17" Foreground="#9FB2C6" x:Name="VersionTextBlock" Text="Not checked" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="32 14 *">
                                <Border Grid.Column="0" Classes="ready-icon" Background="#6B7C8F" x:Name="FilesIcon"><TextBlock x:Name="FilesIconText" Text="?" /></Border>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Client files" />
                                    <TextBlock FontSize="17" Foreground="#9FB2C6" x:Name="FilesDetailTextBlock" Text="Not checked" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="32 14 *">
                                <Border Grid.Column="0" Classes="ready-icon" Background="#6B7C8F" x:Name="RunnerIcon"><TextBlock x:Name="RunnerIconText" Text="?" /></Border>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Runs with" />
                                    <TextBlock FontSize="17" Foreground="#9FB2C6" x:Name="RunnerDetailTextBlock" Text="Not checked" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnDefinitions="32 14 *">
                                <Border Grid.Column="0" Classes="ready-icon" Background="#6B7C8F" x:Name="ServerIcon"><TextBlock x:Name="ServerIconText" Text="?" /></Border>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock FontSize="22" FontWeight="SemiBold" Text="Server" />
                                    <TextBlock FontSize="17" Foreground="#9FB2C6" x:Name="ServerDetailTextBlock" Text="None selected" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- News -->
                <Grid Grid.Column="2" RowDefinitions="Auto *" x:Name="NewsGrid">
                    <TextBlock Grid.Row="0" Classes="heading" FontSize="40" Foreground="#FFAA00" Margin="0 0 0 10" Text="News" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12" Margin="0 0 12 0" x:Name="NewsItemStackPanel">
                            <!-- These are just placeholders that will be replaced in code. -->
                            <HyperlinkButton Classes="news-item">
                                <TextBlock>Midtown Madness, Vibranium Mines One-Shot, and More</TextBlock>
                            </HyperlinkButton>
                            <HyperlinkButton Classes="news-item">
                                <TextBlock>Psylocke Presale Now Available!</TextBlock>
                            </HyperlinkButton>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Background="#B3060A10" ColumnDefinitions="Auto * Auto Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="40 0 0 0" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="15" Background="#2FBF5B"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#06140B" Text="A" /></Border>
                    <TextBlock VerticalAlignment="Center" FontSize="17" Foreground="#9FB2C6" Text="Select" />
                    <Border Width="30" Height="30" CornerRadius="15" Background="#E5484D" Margin="14 0 0 0"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#1A0608" Text="B" /></Border>
                    <TextBlock VerticalAlignment="Center" FontSize="17" Foreground="#9FB2C6" Text="Back" />
                </StackPanel>

                <Button Grid.Column="2" Margin="0 0 12 0" Width="200" x:Name="UpdatesButton" Click="UpdatesButton_Click">Updates</Button>
                <Button Grid.Column="3" Margin="0 0 40 0" Width="200" x:Name="OptionsButton" Click="OptionsButton_Click">Options</Button>
            </Grid>

        </Grid>
    </Viewbox>

</Window>
