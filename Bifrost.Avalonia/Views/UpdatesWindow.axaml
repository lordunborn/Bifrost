<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="420"
        x:Class="Bifrost.Avalonia.Views.UpdatesWindow"
        Title="Client Updates"
        Width="600" Height="420" CanMinimize="False" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Closing="Window_Closing">

    <Grid RowDefinitions="Auto Auto * Auto Auto" Margin="20" RowSpacing="10">

        <!-- Client folder -->
        <Grid Grid.Row="0" ColumnDefinitions="* Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock FontWeight="Bold">Game folder</TextBlock>
                <TextBlock x:Name="FolderTextBlock" TextWrapping="Wrap">C:\Marvel Heroes</TextBlock>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ChangeFolderButton" Click="ChangeFolderButton_Click" VerticalAlignment="Top">Change...</Button>
        </Grid>

        <!-- Progress -->
        <StackPanel Grid.Row="1" Spacing="4">
            <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Height="8" IsVisible="False" />
        </StackPanel>

        <!-- Status -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap">Not checked yet.</TextBlock>
        </ScrollViewer>

        <!-- Update actions -->
        <Grid Grid.Row="3" ColumnDefinitions="* *" ColumnSpacing="8" RowDefinitions="Auto Auto" RowSpacing="8">
            <Button Grid.Column="0" Grid.Row="0" x:Name="CheckButton" Click="CheckButton_Click" HorizontalAlignment="Stretch">Check for updates</Button>
            <Button Grid.Column="1" Grid.Row="0" x:Name="UpdateButton" Click="UpdateButton_Click" HorizontalAlignment="Stretch" IsEnabled="False">Update now</Button>
            <Button Grid.Column="0" Grid.Row="1" x:Name="VerifyButton" Click="VerifyButton_Click" HorizontalAlignment="Stretch">Verify all files (slow)</Button>
            <Button Grid.Column="1" Grid.Row="1" x:Name="RevertButton" Click="RevertButton_Click" HorizontalAlignment="Stretch">Restore original files</Button>
        </Grid>

        <!-- Close -->
        <Button Grid.Row="4" x:Name="CloseButton" Click="CloseButton_Click" IsDefault="True" HorizontalAlignment="Stretch">Close</Button>
    </Grid>

</Window>
