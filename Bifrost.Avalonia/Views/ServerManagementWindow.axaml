<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="Bifrost.Avalonia.Views.ServerManagementWindow"
        Title="Server Management" Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False" CanMinimize="False">

    <Grid RowDefinitions="Auto * Auto" Margin="32 24 32 28" RowSpacing="18">
        <TextBlock Grid.Row="0" Classes="heading" FontSize="44" Text="Servers" />

        <ListBox Grid.Row="1" x:Name="ServerListBox" DoubleTapped="ServerListBox_DoubleTapped" />

        <Grid Grid.Row="2" ColumnDefinitions="* 14 * 14 *">
            <Button Grid.Column="0" Content="Add" Classes="primary" x:Name="AddButton" Click="AddButton_Click" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Edit" x:Name="EditButton" Click="EditButton_Click" HorizontalAlignment="Stretch" />
            <Button Grid.Column="4" Content="Remove" x:Name="RemoveButton" Click="RemoveButton_Click" HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
